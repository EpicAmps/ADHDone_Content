{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADHDone content collection",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
          },
          "type": {
            "enum": [
              "timed_prompt",
              "countdown",
              "guided_exercise",
              "message"
            ]
          },
          "title": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string"
          },
          "completionMessage": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "durationSeconds",
                "instruction"
              ],
              "properties": {
                "durationSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "instruction": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "event": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
